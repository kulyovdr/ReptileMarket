@page "/my-products"
@inject AccountState Account
@inject NavigationManager Navigation

<PageTitle>Мои товары — ReptileMarket</PageTitle>

<div class="catalog-page">
    <div class="products-toolbar">
        <h1 class="products-title">Список товаров</h1>
        <a class="btn btn-primary" href="/create-product">Создать товар</a>
    </div>

    @if (ProductIds.Count == 0)
    {
        <p class="empty-state">
            У вас ещё нет товаров. <a class="empty-state-link" href="/create-product">Хотите создать?</a>
        </p>
    }
    else
    {
        <div class="products-grid">
            @foreach (var id in ProductIds)
            {
                <div class="product-card">
                    <button class="product-edit" type="button" aria-label="Редактировать товар"
                            @onclick='() => Navigation.NavigateTo($"/edit-product/{id}")'>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                        </svg>
                    </button>
                    <button class="product-delete" type="button" aria-label="Удалить товар">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                            <path d="M10 11v6" />
                            <path d="M14 11v6" />
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                        </svg>
                    </button>
                </div>
            }
        </div>

        <div class="pager">
            <button class="pager-btn" type="button" aria-label="Назад" disabled="@_previousDisabled">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12" />
                    <polyline points="12 19 5 12 12 5" />
                </svg>
            </button>
            <button class="pager-btn" type="button" aria-label="Вперёд" disabled="@_nextDisabled">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>
            </button>
        </div>
    }
</div>

@code {
    private readonly List<int> ProductIds = Enumerable.Range(1, 20).ToList();

    private bool _previousDisabled = true;
    private bool _nextDisabled;

    protected override void OnInitialized()
    {
        if (!Account.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }
}
