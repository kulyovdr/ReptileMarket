@page "/profile"
@inject AccountState Account
@inject NavigationManager Navigation

<PageTitle>Аккаунт — ReptileMarket</PageTitle>

<div class="profile-page">
    <div class="profile-card">
        <div class="profile-head">
            <h1 class="profile-title">Аккаунт</h1>
            <button class="profile-logout" type="button" aria-label="Выйти" @onclick="OnLogout">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </button>
        </div>

        <div class="profile-body">
            <div class="profile-photo">
                <button class="profile-photo-edit" type="button" aria-label="Изменить фото">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                    </svg>
                </button>
            </div>

            <div class="profile-info">
                <p class="profile-field"><span>Имя:</span> @(string.IsNullOrWhiteSpace(Account.DisplayName) ? "Anastasia" : Account.DisplayName)</p>
                <p class="profile-field"><span>Логин:</span> Hansola</p>
                <p class="profile-field"><span>Почта:</span> Bublefar@gmail.com</p>
                <p class="profile-field"><span>Пароль:</span> ****************</p>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Account.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void OnLogout()
    {
        Account.Logout();
        Navigation.NavigateTo("/");
    }
}
