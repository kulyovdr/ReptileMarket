@page "/create-product"
@page "/edit-product/{Id:int}"
@inject AccountState Account
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Редактирование товара" : "Новый товар") — ReptileMarket</PageTitle>

<div class="pform">
    <div class="pform-card">
        <button class="pform-back" type="button" aria-label="Назад" @onclick="GoBack">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
            </svg>
        </button>

        <div class="pform-top">
            <div class="pform-photo">
                @if (!string.IsNullOrEmpty(PhotoUrl))
                {
                    <img class="pform-photo-img" src="@PhotoUrl" alt="Фото товара" />
                }
                else
                {
                    <span class="pform-photo-label">Photo</span>
                }

                <div class="pform-photo-pages">
                    @for (var page = 1; page <= 4; page++)
                    {
                        var pageNumber = page;
                        <button class="pform-page @(pageNumber == PhotoPage ? "active" : "")"
                                type="button" @onclick="() => PhotoPage = pageNumber">@pageNumber</button>
                    }
                </div>

                <button class="pform-photo-remove" type="button" aria-label="Удалить фото" @onclick="RemovePhoto">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                        <path d="M10 11v6" />
                        <path d="M14 11v6" />
                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                    </svg>
                </button>

                <label class="pform-photo-edit" title="Выбрать фото">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                    </svg>
                    <InputFile class="pform-file" OnChange="OnPhotoSelected" accept="image/*" />
                </label>
            </div>

            <div class="pform-fields">
                <label class="pfield">
                    <span>Цена</span>
                    <input class="pform-control" type="number" min="0" @bind="Price" />
                </label>
                <label class="pfield">
                    <span>Город</span>
                    <select class="pform-control" @bind="City">
                        <option value="">Выберите</option>
                        @foreach (var city in Cities)
                        {
                            <option value="@city">@city</option>
                        }
                    </select>
                </label>
                <label class="pfield">
                    <span>Пол</span>
                    <select class="pform-control" @bind="Sex">
                        <option value="">Выберите</option>
                        <option value="male">Самец</option>
                        <option value="female">Самка</option>
                    </select>
                </label>
                <label class="pfield">
                    <span>Возраст</span>
                    <input class="pform-control" type="text" @bind="Age" />
                </label>
            </div>
        </div>

        <label class="pfield pfield-wide">
            <span>Вид</span>
            <select class="pform-control" @bind="Species">
                <option value="">Выберите</option>
                @foreach (var species in SpeciesList)
                {
                    <option value="@species">@species</option>
                }
            </select>
        </label>

        <label class="pfield pfield-wide">
            <span>Морфа</span>
            <input class="pform-control" type="text" @bind="Morph" />
        </label>

        <textarea class="pform-description" placeholder="Описание" @bind="Description"></textarea>

        <div class="pform-actions">
            <button class="btn btn-outline" type="button" @onclick="OnSave">Сохранить</button>
            @if (IsEdit)
            {
                <button class="btn btn-outline" type="button" @onclick="OnDelete">Удалить</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool IsEdit => Id.HasValue;

    private int PhotoPage = 1;

    private string PhotoUrl { get; set; } = string.Empty;

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        PhotoUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private void RemovePhoto()
    {
        PhotoUrl = string.Empty;
    }

    private int? Price { get; set; }
    private string City { get; set; } = string.Empty;
    private string Sex { get; set; } = string.Empty;
    private string Age { get; set; } = string.Empty;
    private string Species { get; set; } = string.Empty;
    private string Morph { get; set; } = string.Empty;
    private string Description { get; set; } = string.Empty;

    private static readonly string[] Cities = ["Москва", "Санкт-Петербург", "Казань", "Екатеринбург", "Новосибирск", "Краснодар"];

    private static readonly string[] SpeciesList =
    [
        "Гемитеконникс", "Эублефар", "Бананоед", "Фельзума", "Королевский питон",
        "Бородатая агама", "Маисовый полоз", "Йеменский хамелеон", "Королевская змея",
        "Токи", "Нефрус", "Черепахи"
    ];

    protected override void OnInitialized()
    {
        if (!Account.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/my-products");
    }

    private void OnSave()
    {
        Navigation.NavigateTo("/my-products");
    }

    private void OnDelete()
    {
        Navigation.NavigateTo("/my-products");
    }
}
