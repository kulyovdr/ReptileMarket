@implements IDisposable
@inject AccountState Account

<header class="site-header">
    <div class="header-top">
        <a class="logo" href="/">Reptile<span>Market</span></a>

        <div class="site-search">
            <span class="site-search-icon site-search-icon-left">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="21" y1="21" x2="16.2" y2="16.2" />
                </svg>
            </span>
            <input type="search" placeholder="Найти на ReptileMarket" aria-label="Поиск" />
            <span class="site-search-icon site-search-icon-right">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="4" y1="7" x2="20" y2="7" />
                    <circle cx="9.5" cy="7" r="2.2" fill="#e7e5e2" />
                    <line x1="4" y1="12.5" x2="20" y2="12.5" />
                    <circle cx="15" cy="12.5" r="2.2" fill="#e7e5e2" />
                    <line x1="4" y1="18" x2="20" y2="18" />
                    <circle cx="7" cy="18" r="2.2" fill="#e7e5e2" />
                </svg>
            </span>
        </div>

        <div class="header-actions">
            @if (Account.IsLoggedIn)
            {
                <a class="header-avatar" href="/profile" aria-label="Аккаунт">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </a>
            }
            else
            {
                <a class="btn btn-outline" href="/login">Войти</a>
                <a class="btn btn-primary" href="/register">Регистрация</a>
            }
        </div>
    </div>

    <nav class="header-nav">
        <div class="header-nav-inner">
            <NavLink class="nav-link" href="/catalog">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="4" width="18" height="16" rx="2" />
                    <line x1="8" y1="9.5" x2="16" y2="9.5" />
                    <line x1="8" y1="14.5" x2="16" y2="14.5" />
                </svg>
                Каталог
            </NavLink>
            <NavLink class="nav-link" href="/favorites">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                </svg>
                Избранное
            </NavLink>
            <NavLink class="nav-link" href="/morphopedia">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
                Морфопедия
            </NavLink>
        </div>
    </nav>
</header>

@code {
    protected override void OnInitialized()
    {
        Account.Changed += OnAccountChanged;
    }

    private void OnAccountChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Account.Changed -= OnAccountChanged;
    }
}
