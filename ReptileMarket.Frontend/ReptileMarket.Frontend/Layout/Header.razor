@implements IDisposable
@inject AccountState Account
@inject ProductStore Store
@inject IJSRuntime JS
@inject NavigationManager Navigation


<header class="site-header">
    <div class="header-top">
        <a class="logo" href="/">Reptile<span>Market</span></a>

        <div class="site-search">
            <span class="site-search-icon site-search-icon-left">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="21" y1="21" x2="16.2" y2="16.2" />
                </svg>
            </span>
            <input type="search" placeholder="Найти на ReptileMarket" aria-label="Поиск" autocomplete="off"
                   @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKeyDown"
                   @onfocus="OnSearchFocus" @onblur="OnSearchBlur" />
            <span class="site-search-icon site-search-icon-right" role="button" tabindex="0" aria-label="Фильтры" title="Фильтры"
                  @onclick="() => FiltersOpen = true"
                  @onkeydown="@(async e => { if (e.Key == "Enter" || e.Key == " ") FiltersOpen = true; })">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="4" y1="7" x2="20" y2="7" />
                    <circle cx="9.5" cy="7" r="2.2" fill="#e7e5e2" />
                    <line x1="4" y1="12.5" x2="20" y2="12.5" />
                    <circle cx="15" cy="12.5" r="2.2" fill="#e7e5e2" />
                    <line x1="4" y1="18" x2="20" y2="18" />
                    <circle cx="7" cy="18" r="2.2" fill="#e7e5e2" />
                </svg>
            </span>

            @if (_historyOpen && _history.Count > 0)
            {
                <div class="search-suggest">
                    <div class="search-suggest-head">
                        <span>Раньше искали</span>
                        <button type="button" @onclick:preventDefault="true" @onmousedown:preventDefault="true"
                                @onclick="ClearHistory">Очистить</button>
                    </div>
                    @foreach (var item in _history)
                    {
                        <button class="search-suggest-item" type="button"
                                @onmousedown:preventDefault="true"
                                @onmousedown="() => PickHistory(item)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                                <polyline points="12 7 12 12 15 14" />
                            </svg>
                            @item
                        </button>
                    }
                </div>
            }
        </div>

        <div class="header-actions">
            @if (Account.IsLoggedIn)
            {
                <a class="header-avatar" href="/profile" aria-label="Аккаунт">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="8" r="4.2" />
                        <path d="M3.5 21.2c.5-4.6 4-7.2 8.5-7.2s8 2.6 8.5 7.2c.05.5-.35.8-.85.8h-15.3c-.5 0-.9-.3-.85-.8z" />
                    </svg>
                </a>
            }
            else
            {
                <a class="btn btn-outline" href="/login">Войти</a>
                <a class="btn btn-primary" href="/register">Регистрация</a>
            }
        </div>
    </div>

    <nav class="header-nav">
        <div class="header-nav-scroll">
            <button class="nav-arrow nav-arrow-left" type="button" aria-label="Прокрутить меню влево" @ref="_navLeftEl">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
            </button>
            <div class="header-nav-inner" @ref="_navEl">
                <NavLink class="nav-link" href="/catalog">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <line x1="8" y1="9.5" x2="16" y2="9.5" />
                        <line x1="8" y1="14.5" x2="16" y2="14.5" />
                    </svg>
                    Каталог
                </NavLink>
                @if (Account.IsLoggedIn)
                {
                    <NavLink class="nav-link" href="/favorites">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                        Избранное
                        @if (Store.FavoriteCount > 0)
                        {
                            <span class="nav-badge">@Store.FavoriteCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="/my-products">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <path d="M16 10a4 4 0 0 1-8 0" />
                        </svg>
                        Мои товары
                    </NavLink>
                    <NavLink class="nav-link" href="/chats">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                        Чаты
                    </NavLink>
                }
                <NavLink class="nav-link" href="/morphopedia">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                    </svg>
                    Морфопедия
                </NavLink>
            </div>
            <button class="nav-arrow nav-arrow-right" type="button" aria-label="Прокрутить меню вправо" @ref="_navRightEl">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </button>
        </div>
    </nav>
</header>

<SearchFilters Open="FiltersOpen" OpenChanged="v => FiltersOpen = v" />

@code {
    private bool FiltersOpen;
    private string _search = string.Empty;
    private List<string> _history = [];
    private bool _historyOpen;

    private ElementReference _navEl;
    private ElementReference _navLeftEl;
    private ElementReference _navRightEl;

    protected override void OnInitialized()
    {
        Account.Changed += OnAccountChanged;
        Store.Changed += OnStoreChanged;
        Navigation.LocationChanged += OnLocationChanged;
        SyncSearchFromUrl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("rmNavArrows", _navEl, _navLeftEl, _navRightEl);
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var q = _search.Trim();
            _historyOpen = false;
            await JS.InvokeVoidAsync("rmSearchHistory.add", q);
            Navigation.NavigateTo(q.Length == 0 ? "/catalog" : $"/catalog?search={Uri.EscapeDataString(q)}");
        }
        else if (e.Key == "Escape")
        {
            _historyOpen = false;
        }
    }

    private async Task OnSearchFocus()
    {
        try
        {
            _history = await JS.InvokeAsync<List<string>>("rmSearchHistory.get");
        }
        catch
        {
            _history = [];
        }

        _historyOpen = _history.Count > 0;
    }

    private void OnSearchBlur()
    {
        _historyOpen = false;
    }

    private async Task PickHistory(string item)
    {
        _search = item;
        _historyOpen = false;
        await JS.InvokeVoidAsync("rmSearchHistory.add", item);
        Navigation.NavigateTo($"/catalog?search={Uri.EscapeDataString(item)}");
    }

    private async Task ClearHistory()
    {
        await JS.InvokeVoidAsync("rmSearchHistory.clear");
        _history = [];
        _historyOpen = false;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SyncSearchFromUrl();
        StateHasChanged();
    }

    private void SyncSearchFromUrl()
    {
        var query = new Uri(Navigation.Uri).Query;
        if (query.StartsWith('?'))
        {
            query = query[1..];
        }

        var search = string.Empty;
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var idx = part.IndexOf('=');
            if (idx > 0 && part[..idx] == "search")
            {
                search = Uri.UnescapeDataString(part[(idx + 1)..]);
                break;
            }
        }

        if (!string.Equals(search, _search, StringComparison.Ordinal))
        {
            _search = search;
        }
    }

    private void OnAccountChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnStoreChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Account.Changed -= OnAccountChanged;
        Store.Changed -= OnStoreChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
