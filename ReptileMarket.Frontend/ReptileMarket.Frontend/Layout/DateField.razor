@using System.Globalization
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="datepick">
    <button type="button" class="pform-control datepick-btn" @onclick="Toggle">
        <span class="@(Value.HasValue ? "" : "datepick-empty")">@(Value?.ToString("dd.MM.yyyy") ?? Placeholder)</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
    </button>
    @if (_open)
    {
        <div class="datepick-overlay" @onclick="Close"></div>
        <div class="datepick-pop">
            <div class="dp-head">
                <span class="dp-title">@($"{_calView.ToString("MMMM", Ru)} {_calView.Year}")</span>
                <div class="dp-nav">
                    <button type="button" aria-label="Предыдущий месяц" @onclick="PrevMonth">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15" /></svg>
                    </button>
                    <button type="button" aria-label="Следующий месяц" @onclick="NextMonth">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                    </button>
                </div>
            </div>
            <div class="dp-grid dp-week">
                @foreach (var wd in WeekDays)
                {
                    <span>@wd</span>
                }
            </div>
            <div class="dp-grid">
                @for (var b = 0; b < LeadingBlanks(); b++)
                {
                    <span class="dp-blank"></span>
                }
                @for (var d = 1; d <= DateTime.DaysInMonth(_calView.Year, _calView.Month); d++)
                {
                    var day = d;
                    var date = new DateTime(_calView.Year, _calView.Month, day);
                    var cls = "";
                    if (Value?.Date == date) { cls = "selected"; }
                    else if (date.Date == DateTime.Today) { cls = "today"; }
                    <button type="button" class="@cls" @onclick="() => PickDayAsync(day)">@day</button>
                }
            </div>
            <div class="dp-foot">
                <button type="button" class="dp-link" @onclick="ClearAsync">Очистить</button>
                <button type="button" class="dp-link" @onclick="PickTodayAsync">Сегодня</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public DateTime? Value { get; set; }

    [Parameter]
    public EventCallback<DateTime?> ValueChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "дд.мм.гггг";

    private bool _open;
    private DateTime _calView = DateTime.Today;
    private static readonly CultureInfo Ru = CultureInfo.GetCultureInfo("ru-RU");
    private static readonly string[] WeekDays = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_open)
        {
            _open = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void Toggle()
    {
        if (!_open)
        {
            _calView = Value ?? DateTime.Today;
        }
        _open = !_open;
    }

    private void Close()
    {
        _open = false;
    }

    private void PrevMonth()
    {
        _calView = _calView.AddMonths(-1);
    }

    private void NextMonth()
    {
        _calView = _calView.AddMonths(1);
    }

    private int LeadingBlanks()
    {
        return ((int)new DateTime(_calView.Year, _calView.Month, 1).DayOfWeek + 6) % 7;
    }

    private async Task PickDayAsync(int day)
    {
        Value = new DateTime(_calView.Year, _calView.Month, day);
        _open = false;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task ClearAsync()
    {
        Value = null;
        _open = false;
        await ValueChanged.InvokeAsync(null);
    }

    private async Task PickTodayAsync()
    {
        Value = DateTime.Today;
        _calView = DateTime.Today;
        _open = false;
        await ValueChanged.InvokeAsync(Value);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
